<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_aa_job_portal" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.aa_job_portal</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_recruitment.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='online_posting_setting_container']" position="inside">
                <setting id="aa_job_portal_redirect_setting" string="Candidate Dashboard"
                         help="Job seekers who open the portal (/my) land directly on their candidate dashboard (/my/jobs)">
                    <field name="aa_job_portal_redirect_home"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
